# Core API configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/founderverse
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

# Firebase Admin credentials (use the JSON service account value supported by firebaseAdmin.js)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_WEB_API_KEY=

# Human admins can moderate users and startup listings.
# System operators can manage human-admin access and inspect platform health.
# Neither role is selectable in public profiles.
ADMIN_EMAILS=admin@example.com
SYSTEM_EMAILS=operator@example.com
